DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/siegebreak
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me
MATCH_SERVER_SECRET=replace-me-server-to-server-only
# Comma-separated allowed browser origins; unset reflects any origin (dev only).
CORS_ORIGINS=http://localhost:5173
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
PHOTON_APP_ID=
# Realtime session provider for allocated matches: "local" (default) or "photon".
SESSION_PROVIDER=local
# Region stamped onto allocated sessions (informational for now).
MATCH_REGION=eu
