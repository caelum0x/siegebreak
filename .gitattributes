* text=auto

# Unity YAML assets — treat as text so diffs are readable
*.unity      text eol=lf
*.asset      text eol=lf
*.prefab     text eol=lf
*.mat        text eol=lf
*.meta       text eol=lf
*.controller text eol=lf
*.anim       text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.unitypackage binary
