{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card",
  "type": "object",
  "required": ["cardId", "name", "type", "elixirCost"],
  "properties": {
    "cardId": { "type": "string" },
    "name": { "type": "string" },
    "type": { "enum": ["troop", "spell", "building", "hero"] },
    "elixirCost": { "type": "integer", "minimum": 1, "maximum": 9 },
    "baseStats": { "type": "object" }
  }
}
